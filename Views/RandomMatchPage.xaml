<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.RandomMatchPage"
             Title="Jogo Aleatório"
             BackgroundColor="#0A1020">

    <ScrollView>
        <VerticalStackLayout Padding="28,32,28,40" Spacing="0">

            <!-- ══ Cabeçalho ══ -->
            <Label Text="🌐  Jogo Aleatório"
                   TextColor="White" FontSize="23" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Escolha o tempo e conecte com um jogador agora"
                   TextColor="#4A6888" FontSize="13"
                   HorizontalTextAlignment="Center" Margin="0,4,0,32"/>

            <!-- ══ Seção 1: Escolha de Tempo ══ -->
            <VerticalStackLayout x:Name="SelectionSection" Spacing="12">

                <Label Text="Controle de Tempo"
                       TextColor="#9ABCDE" FontSize="14" FontAttributes="Bold"
                       Margin="0,0,0,2"/>

                <!-- Linha 1: Bullet 1' | Blitz 3' | Blitz 5' -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border x:Name="TcBullet"
                            BackgroundColor="#0E1828" Stroke="#1A2840" StrokeThickness="2"
                            StrokeShape="RoundRectangle 10" Padding="6,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="1'" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Bullet" TextColor="#607890" FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="1"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" x:Name="TcBlitz3"
                            BackgroundColor="#0E1828" Stroke="#1A2840" StrokeThickness="2"
                            StrokeShape="RoundRectangle 10" Padding="6,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="3'" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Blitz" TextColor="#607890" FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="3"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="2" x:Name="TcBlitz5"
                            BackgroundColor="#0A1828" Stroke="#2A5090" StrokeThickness="2"
                            StrokeShape="RoundRectangle 10" Padding="6,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="5'" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Blitz" TextColor="#4A8AC0" FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="5"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Linha 2: Rápido 10' | Rápido 15' -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,20">
                    <Border x:Name="TcRapid10"
                            BackgroundColor="#0E1828" Stroke="#1A2840" StrokeThickness="2"
                            StrokeShape="RoundRectangle 10" Padding="6,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="10'" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Rápido" TextColor="#607890" FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="10"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" x:Name="TcRapid15"
                            BackgroundColor="#0E1828" Stroke="#1A2840" StrokeThickness="2"
                            StrokeShape="RoundRectangle 10" Padding="6,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="15'" TextColor="White" FontSize="22" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Rápido" TextColor="#607890" FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="15"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Button Text="Buscar Oponente"
                        Clicked="OnSearchClicked"
                        BackgroundColor="#1A4A2A" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        CornerRadius="12" HeightRequest="52"/>

            </VerticalStackLayout>

            <!-- ══ Seção 2: Buscando ══ -->
            <VerticalStackLayout x:Name="SearchingSection" IsVisible="False" Spacing="20">

                <ActivityIndicator x:Name="SearchSpinner"
                                   IsRunning="True" Color="#4CAF50"
                                   WidthRequest="52" HeightRequest="52"
                                   HorizontalOptions="Center" Margin="0,8,0,0"/>

                <Label x:Name="SearchingLabel"
                       Text="Procurando oponente..."
                       TextColor="White" FontSize="18" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <Label x:Name="SearchSubLabel"
                       Text="5' Blitz · Qualquer rating"
                       TextColor="#4A6888" FontSize="13"
                       HorizontalTextAlignment="Center"/>

                <Button Text="Cancelar"
                        Clicked="OnCancelClicked"
                        BackgroundColor="Transparent" TextColor="#8A9AB0"
                        BorderColor="#2A3A50" BorderWidth="1"
                        FontSize="14" CornerRadius="10" HeightRequest="42"
                        Margin="40,12,40,0"/>

            </VerticalStackLayout>

            <!-- ══ Seção 3: Partida Confirmada ══ -->
            <VerticalStackLayout x:Name="ConfirmedSection" IsVisible="False" Spacing="16">

                <Label Text="✓  Oponente encontrado!"
                       TextColor="#4CAF50" FontSize="21" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <!-- Card do oponente -->
                <Border BackgroundColor="#0E1828" Stroke="#2A4A6A" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12" Padding="16,14" Margin="0,4,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="♟" FontSize="32" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0"
                                            Spacing="3" VerticalOptions="Center">
                            <Label x:Name="OppNameLabel" Text="Oponente"
                                   TextColor="White" FontSize="17" FontAttributes="Bold"/>
                            <Label x:Name="OppRatingLabel" Text="Rating: —"
                                   TextColor="#607890" FontSize="12"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="✓ Online"
                               TextColor="#4CAF50" FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Label x:Name="ConfirmedDetailsLabel"
                       Text="5' Blitz  ·  Você joga com as Brancas ♙"
                       TextColor="White" FontSize="15"
                       HorizontalTextAlignment="Center"/>

                <Label x:Name="CountdownLabel"
                       Text="Iniciando em 3..."
                       TextColor="#9ABCDE" FontSize="17" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" Margin="0,6,0,0"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
