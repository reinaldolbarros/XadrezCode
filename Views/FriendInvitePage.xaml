<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.FriendInvitePage"
             Title="Com Amigo"
             BackgroundColor="#0A1020">

    <ScrollView>
        <VerticalStackLayout Padding="28,24,28,40" Spacing="14">

            <!-- ══ Cabeçalho ══ -->
            <Border BackgroundColor="#0E1E38" Stroke="#2A5090" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14" Padding="18,18">
                <HorizontalStackLayout Spacing="16">
                    <Label Text="👥" FontSize="36" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="Nova Partida Privada"
                               TextColor="White" FontSize="19" FontAttributes="Bold"/>
                        <Label Text="Dois jogadores · mesmo celular"
                               TextColor="#5A7898" FontSize="13"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- ══ Jogadores ══ -->
            <Border BackgroundColor="#0D1828" Stroke="#1A2840" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="18,18">
                <VerticalStackLayout Spacing="16">

                    <!-- Brancas -->
                    <VerticalStackLayout Spacing="7">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="♙" TextColor="#EED5A0" FontSize="19" VerticalOptions="Center"/>
                            <Label Text="Brancas  (começa jogando)"
                                   TextColor="#8AB0D0" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border BackgroundColor="#111D32" Stroke="#2A4060" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10" Padding="14,0">
                            <Entry x:Name="Player1Entry"
                                   Placeholder="Seu nome"
                                   PlaceholderColor="#3A5070"
                                   TextColor="White" FontSize="16"
                                   HeightRequest="50"
                                   BackgroundColor="Transparent"
                                   MaxLength="20"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView Color="#1A2840" HeightRequest="1"/>

                    <!-- Pretas -->
                    <VerticalStackLayout Spacing="7">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="♟" TextColor="#8090A0" FontSize="19" VerticalOptions="Center"/>
                            <Label Text="Pretas"
                                   TextColor="#8AB0D0" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border BackgroundColor="#111D32" Stroke="#2A4060" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10" Padding="14,0">
                            <Entry x:Name="Player2Entry"
                                   Placeholder="Nome do amigo"
                                   PlaceholderColor="#3A5070"
                                   TextColor="White" FontSize="16"
                                   HeightRequest="50"
                                   BackgroundColor="Transparent"
                                   MaxLength="20"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ══ Tempo por jogador ══ -->
            <Border BackgroundColor="#0D1828" Stroke="#1A2840" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="18,16">
                <VerticalStackLayout Spacing="12">

                    <Label Text="⏱  Tempo por jogador"
                           TextColor="White" FontSize="15" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">

                        <!-- Sem limite (selecionado por padrão) -->
                        <Border x:Name="TimeBtn0"
                                BackgroundColor="#1A3A65" Stroke="#2A5090"
                                StrokeThickness="1.5" StrokeShape="RoundRectangle 10"
                                Padding="0,13">
                            <Label Text="∞" TextColor="White" FontSize="17" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="0"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Grid.Column="1" x:Name="TimeBtn1"
                                BackgroundColor="#111D32" Stroke="#1A2840"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                Padding="0,13">
                            <Label Text="1m" TextColor="#607890" FontSize="14"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="1"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Grid.Column="2" x:Name="TimeBtn3"
                                BackgroundColor="#111D32" Stroke="#1A2840"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                Padding="0,13">
                            <Label Text="3m" TextColor="#607890" FontSize="14"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="3"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Grid.Column="3" x:Name="TimeBtn5"
                                BackgroundColor="#111D32" Stroke="#1A2840"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                Padding="0,13">
                            <Label Text="5m" TextColor="#607890" FontSize="14"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="5"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Grid.Column="4" x:Name="TimeBtn10"
                                BackgroundColor="#111D32" Stroke="#1A2840"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                Padding="0,13">
                            <Label Text="10m" TextColor="#607890" FontSize="14"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTimeSelected" CommandParameter="10"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ══ Botão iniciar ══ -->
            <Button Text="▶  INICIAR PARTIDA"
                    Clicked="OnStartClicked"
                    BackgroundColor="#2A4A6A"
                    TextColor="White"
                    FontAttributes="Bold" FontSize="17"
                    CornerRadius="14" HeightRequest="58"
                    Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
