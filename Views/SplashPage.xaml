<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A1020">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">

            <!-- ══ Peças (idêntico ao LoginPage) ══ -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">

                <!-- Rei: sombra progressiva + peça branca -->
                <Grid VerticalOptions="End" ScaleX="0.9">
                    <Label Text="♚" FontSize="110" TextColor="#000000" Opacity="0.75"
                           TranslationX="10" TranslationY="9"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#050505" Opacity="0.60"
                           TranslationX="8"  TranslationY="7"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#111111" Opacity="0.45"
                           TranslationX="6"  TranslationY="5"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#1E1E1E" Opacity="0.30"
                           TranslationX="4"  TranslationY="3"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#303030" Opacity="0.20"
                           TranslationX="3"  TranslationY="2"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#484848" Opacity="0.12"
                           TranslationX="2"  TranslationY="1"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="#606060" Opacity="0.06"
                           TranslationX="1"  TranslationY="0"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♚" FontSize="110" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                </Grid>

                <!-- Cavalo: glow branco + peça preta -->
                <Grid VerticalOptions="End" Margin="-42,0,0,0">
                    <Label Text="♞" FontSize="96" TextColor="White"
                           Margin="1,0,0,1"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                    <Label Text="♞" FontSize="90" TextColor="#1A1209"
                           HorizontalOptions="Center" VerticalOptions="End"/>
                </Grid>

            </HorizontalStackLayout>

            <!-- ══ Nome do app ══ -->
            <Label Text="ChessArena"
                   FontSize="48" FontAttributes="Bold" TextColor="White"
                   HorizontalTextAlignment="Center" Margin="0,14,0,6"/>

            <!-- ══ Slogan ══ -->
            <Label Text="Jogue · Evolua · Conquiste"
                   FontSize="15" TextColor="#3A4E6A"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
