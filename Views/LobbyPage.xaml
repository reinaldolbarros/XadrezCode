<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.LobbyPage"
             BackgroundColor="#0A1020">

    <VerticalStackLayout Padding="16,10,16,12" Spacing="5">

        <!-- ══ Cabeçalho: logo + nome ══ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="♚" FontSize="22" TextColor="#FFD700" VerticalOptions="Center"/>
                <Label Text="ChessArena" TextColor="White" FontSize="18"
                       FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Button Grid.Column="2"
                    Text="⋮"
                    Clicked="OnMenuClicked"
                    BackgroundColor="Transparent" TextColor="White"
                    FontSize="24" HeightRequest="36" WidthRequest="36"
                    Padding="0" CornerRadius="0" VerticalOptions="Center"/>
        </Grid>

        <!-- ══ Perfil ══ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">

            <Border BackgroundColor="#111D32" Stroke="#1C2D4A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    WidthRequest="48" HeightRequest="48"
                    VerticalOptions="Center" Margin="0,0,12,0">
                <Grid>
                    <Label x:Name="AvatarLabel" Text="♟" FontSize="26"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Image x:Name="AvatarImage" IsVisible="False"
                           Aspect="AspectFill"
                           WidthRequest="48" HeightRequest="48"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAvatarTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label x:Name="NameLabel" Text="Jogador"
                       TextColor="White" FontSize="17" FontAttributes="Bold"/>
                <Label x:Name="ProfileLocationLabel" Text=""
                       TextColor="#9AAEC8" FontSize="13"/>
                <Label x:Name="RatingLabel" Text="Rating: 1200"
                       TextColor="#5A9AD0" FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAdminActivate"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="StarsLabel" Text="⭐ 0 · Casual"
                       TextColor="#C8A020" FontSize="12"/>
            </VerticalStackLayout>

            <Button x:Name="AdminBtn" Grid.Column="2"
                    Text="⚙ Admin"
                    Clicked="OnAdminPageClicked"
                    IsVisible="False"
                    BackgroundColor="Transparent" TextColor="#4A6080"
                    FontSize="14" HeightRequest="32" Padding="4,0"
                    CornerRadius="0" VerticalOptions="Center"/>
        </Grid>

        <!-- ══ 1. Jogo Aleatório ══ -->
        <Border BackgroundColor="#0A1E3A" Stroke="#2A5A9A" StrokeThickness="2"
                StrokeShape="RoundRectangle 14" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="🌐" FontSize="28" VerticalOptions="Center" Margin="0,0,12,0"/>
                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Jogo Aleatório" TextColor="White"
                               FontSize="17" FontAttributes="Bold"/>
                        <Label Text="Conecte com um jogador online agora"
                               TextColor="#9AAEC8" FontSize="14"/>
                    </VerticalStackLayout>
                    <Button Text="Jogar Agora"
                            Clicked="OnRandomMatchClicked"
                            BackgroundColor="#1A5AA0" TextColor="White"
                            FontAttributes="Bold" FontSize="14"
                            CornerRadius="10" HeightRequest="40"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ══ 2. Modo Carreira ══ -->
        <Border BackgroundColor="#0E1E14" Stroke="#1A4030" StrokeThickness="1.5"
                StrokeShape="RoundRectangle 12" Padding="14,11">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="♟" FontSize="24" TextColor="#4CAF50" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                    <Label Text="Modo Carreira" TextColor="White"
                           FontSize="16" FontAttributes="Bold"/>
                    <Label x:Name="CareerSubLabel"
                           Text="Do clube local ao campeonato mundial"
                           TextColor="#8AB898" FontSize="13"/>
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="›" TextColor="#4CAF50"
                       FontSize="24" VerticalOptions="Center"/>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCareerClicked"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- ══ 3 + 4. Com Amigo · Jogo vs IA ══ -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">

            <Border BackgroundColor="#0C1828" Stroke="#1E3A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="12,10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="👥" FontSize="22" HorizontalTextAlignment="Center"/>
                    <Label Text="Com Amigo" TextColor="White"
                           FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Pass &amp; play local"
                           TextColor="#9AAEC8" FontSize="13"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFriendGameTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="1" BackgroundColor="#121A10" Stroke="#2A3A20"
                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🤖" FontSize="22" HorizontalTextAlignment="Center"/>
                    <Label Text="Jogo vs IA" TextColor="White"
                           FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Treino · qualquer hora"
                           TextColor="#8AA898" FontSize="13"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickPlayTapped"/>
                </Border.GestureRecognizers>
            </Border>

        </Grid>

        <!-- ══ Bônus Diário ══ -->
        <Border x:Name="BonusFrame"
                BackgroundColor="#0D1828" Stroke="#1A2840" StrokeThickness="1"
                StrokeShape="RoundRectangle 10" Padding="14,9">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                    <Label x:Name="BonusTitle" Text="Bônus Diário"
                           TextColor="#FFD700" FontSize="16" FontAttributes="Bold"/>
                    <Label x:Name="BonusStreakLabel" Text="Sequência: 1 dia"
                           TextColor="#A0B0C8" FontSize="15"/>
                </VerticalStackLayout>
                <Button x:Name="BonusBtn" Text="Resgatar"
                        Grid.Column="1"
                        Clicked="OnBonusClicked"
                        BackgroundColor="#FFD700" TextColor="#0A1020"
                        FontAttributes="Bold" FontSize="14"
                        CornerRadius="8" HeightRequest="32" WidthRequest="82"
                        IsVisible="False"/>
            </Grid>
        </Border>

        <!-- ══ Missões Diárias ══ -->
        <Border BackgroundColor="#0D1828" Stroke="#1A2840" StrokeThickness="1"
                StrokeShape="RoundRectangle 10" Padding="14,10">
            <VerticalStackLayout Spacing="5">
                <Label Text="Missões de Hoje" TextColor="White"
                       FontSize="16" FontAttributes="Bold"/>
                <VerticalStackLayout x:Name="MissionContainer" Spacing="5"/>
            </VerticalStackLayout>
        </Border>

        <!-- ══ Estatísticas ══ -->
        <Border BackgroundColor="#0D1828" Stroke="#1A2840" StrokeThickness="1"
                StrokeShape="RoundRectangle 10" Padding="14,10">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                    <Label x:Name="WinsLabel" Text="0"
                           TextColor="#4CAF50" FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Vitórias" TextColor="#A0B0C8" FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="0">
                    <Label x:Name="LossesLabel" Text="0"
                           TextColor="#FF5252" FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Derrotas" TextColor="#A0B0C8" FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="0">
                    <Label x:Name="TournWinsLabel" Text="0"
                           TextColor="#FFD700" FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Torneios" TextColor="#A0B0C8" FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </VerticalStackLayout>

</ContentPage>
