<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMAUI.Views.LobbyPage"
             BackgroundColor="#001B26"
             Shell.NavBarIsVisible="False">

    <Grid Padding="16,14,16,14" RowSpacing="18"
          RowDefinitions="Auto,2.2*,2.2*,1.4*,*,*,*">

        <!-- ══ Row 0: Perfil + Menu ══ -->
        <Grid ColumnDefinitions="66,*,44">
            <Border WidthRequest="54" HeightRequest="54"
                    Stroke="#FFD447" StrokeThickness="1.5"
                    BackgroundColor="#101A31"
                    StrokeShape="RoundRectangle 27"
                    VerticalOptions="Center">
                <Grid>
                    <Label x:Name="AvatarLabel" Text="👑" FontSize="30"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                    <Image x:Name="AvatarImage" IsVisible="False"
                           Aspect="AspectFill"
                           WidthRequest="54" HeightRequest="54"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAvatarTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label x:Name="NameLabel" Text="Jogador"
                       FontSize="20" FontAttributes="Bold" TextColor="#F2F5F8"/>
                <Label x:Name="ProfileLocationLabel" Text=""
                       FontSize="12" TextColor="#9FB3C8"/>
                <HorizontalStackLayout Spacing="12">
                    <Label x:Name="RatingLabel" Text="Rating: 1200"
                           FontSize="12" TextColor="#4AA3FF">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAdminActivate"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="StarsLabel" Text="⭐ 0 · Casual"
                           FontSize="12" TextColor="#FFD447"/>
                </HorizontalStackLayout>
                <Button x:Name="AdminBtn"
                        Text="⚙ Admin"
                        Clicked="OnAdminPageClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#4A6080"
                        FontSize="11" HeightRequest="22" Padding="0"
                        CornerRadius="0" HorizontalOptions="Start"/>
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="⋮"
                    Clicked="OnMenuClicked"
                    BackgroundColor="Transparent" TextColor="#F2F5F8"
                    FontSize="28" HeightRequest="44" WidthRequest="44"
                    Padding="0" CornerRadius="0" VerticalOptions="Center"/>
        </Grid>

        <!-- ══ Row 1: Jogar Online ══ -->
        <Border Grid.Row="1"
                BackgroundColor="#071F3C" Stroke="#2E7DDB" StrokeThickness="1.4"
                StrokeShape="RoundRectangle 18" Padding="16"
                VerticalOptions="Fill">
            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,*"
                  ColumnSpacing="14" RowSpacing="10">
                <Border Grid.RowSpan="2"
                        WidthRequest="56" HeightRequest="56"
                        BackgroundColor="#082641"
                        Stroke="#2E7DDB" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text="🌐" FontSize="32"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="3">
                    <Label Text="Jogar Online" FontSize="20" FontAttributes="Bold" TextColor="#F2F5F8"/>
                    <Label Text="Conecte com um jogador agora" FontSize="13" TextColor="#9FB3C8"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Grid.Row="1"
                        Text="Jogar Agora   ›"
                        Clicked="OnRandomMatchClicked"
                        BackgroundColor="#2A67B1" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        CornerRadius="12" HeightRequest="42"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- ══ Row 2: Modo Carreira ══ -->
        <Border Grid.Row="2"
                BackgroundColor="#032D20" Stroke="#2E8C45" StrokeThickness="1.4"
                StrokeShape="RoundRectangle 18" Padding="16"
                VerticalOptions="Fill">
            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,*"
                  ColumnSpacing="14" RowSpacing="10">
                <Border Grid.RowSpan="2"
                        WidthRequest="56" HeightRequest="56"
                        BackgroundColor="#082641"
                        Stroke="#2E8C45" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text="♟" FontSize="32" TextColor="#4CAF50"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="3">
                    <Label Text="Modo Carreira" FontSize="20" FontAttributes="Bold" TextColor="#F2F5F8"/>
                    <Label x:Name="CareerSubLabel"
                           Text="Do clube local ao campeonato mundial"
                           FontSize="13" TextColor="#9FB3C8"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Grid.Row="1"
                        Text="Continuar   ›"
                        Clicked="OnCareerClicked"
                        BackgroundColor="#1F6B36" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        CornerRadius="12" HeightRequest="42"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- ══ Row 3: Com Amigo + Jogo vs IA ══ -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border BackgroundColor="#05233A" Stroke="#1D4F7F" StrokeThickness="1.2"
                    StrokeShape="RoundRectangle 16" Padding="14,0"
                    VerticalOptions="Fill">
                <Grid ColumnDefinitions="46,*,18">
                    <Label Text="👥" FontSize="28" VerticalTextAlignment="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Com Amigo" FontSize="16" FontAttributes="Bold" TextColor="#F2F5F8"/>
                        <Label Text="Pass &amp; play local" FontSize="12" TextColor="#9FB3C8"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#9FB3C8"
                           VerticalTextAlignment="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFriendGameTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="1" BackgroundColor="#101333" Stroke="#393D70" StrokeThickness="1.2"
                    StrokeShape="RoundRectangle 16" Padding="14,0"
                    VerticalOptions="Fill">
                <Grid ColumnDefinitions="46,*,18">
                    <Label Text="🤖" FontSize="28" VerticalTextAlignment="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Jogo vs IA" FontSize="16" FontAttributes="Bold" TextColor="#F2F5F8"/>
                        <Label Text="Treino · qualquer hora" FontSize="12" TextColor="#9FB3C8"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#9FB3C8"
                           VerticalTextAlignment="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickPlayTapped"/>
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ══ Row 4: Puzzle do Dia ══ -->
        <Border Grid.Row="4" x:Name="PuzzleCard"
                BackgroundColor="#061F33" Stroke="#173957" StrokeThickness="1.1"
                StrokeShape="RoundRectangle 16" Padding="16,0"
                VerticalOptions="Fill">
            <Grid ColumnDefinitions="50,*,Auto">
                <Label Text="🧩" FontSize="28" VerticalTextAlignment="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" Margin="6,0,0,0">
                    <Label Text="Puzzle do Dia" FontSize="16" FontAttributes="Bold" TextColor="#F2F5F8"/>
                    <Label x:Name="PuzzleSubLabel"
                           Text="Um desafio novo todo dia"
                           FontSize="12" TextColor="#9FB3C8"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Label x:Name="PuzzleSolvedBadge"
                       Grid.Column="2"
                       Text="🔒  Premium"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#C18CFF"
                       VerticalTextAlignment="Center"
                       IsVisible="False"
                       Margin="8,0,0,0"/>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPuzzleTapped"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- ══ Row 5: Bônus Diário ══ -->
        <Border Grid.Row="5" x:Name="BonusFrame"
                BackgroundColor="#061F33" Stroke="#3A2E68" StrokeThickness="1.1"
                StrokeShape="RoundRectangle 16" Padding="16,0"
                VerticalOptions="Fill">
            <Grid ColumnDefinitions="50,*,Auto">
                <Label Text="🎁" FontSize="28" VerticalTextAlignment="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" Margin="6,0,0,0">
                    <Label x:Name="BonusTitle" Text="Bônus Diário"
                           FontSize="16" FontAttributes="Bold" TextColor="#A56CFF"
                           LineBreakMode="WordWrap"/>
                    <Label x:Name="BonusStreakLabel" Text="Sequência: 1 dia"
                           FontSize="12" TextColor="#9FB3C8"/>
                </VerticalStackLayout>
                <Button x:Name="BonusBtn" Grid.Column="2"
                        Text="Resgatar"
                        Clicked="OnBonusClicked"
                        BackgroundColor="#FFD700" TextColor="#0A1020"
                        FontAttributes="Bold" FontSize="13"
                        CornerRadius="8" HeightRequest="36" WidthRequest="82"
                        IsVisible="False"
                        Margin="8,0,0,0"/>
                <Label x:Name="BonusArrow" Grid.Column="2"
                       Text="›" FontSize="24" TextColor="#9FB3C8"
                       VerticalTextAlignment="Center"
                       IsVisible="True"
                       Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Row 6: Estatísticas ══ -->
        <Border Grid.Row="6"
                BackgroundColor="#082941" Stroke="#173957" StrokeThickness="1.2"
                StrokeShape="RoundRectangle 16" Padding="12,0"
                VerticalOptions="Fill">
            <Grid ColumnDefinitions="*,1,*,1,*">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="WinsLabel" Text="0"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#64D363"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Vitórias" FontSize="12" TextColor="#9FB3C8"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="36"
                         BackgroundColor="#264056" VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="LossesLabel" Text="0"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#FF5B5B"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Derrotas" FontSize="12" TextColor="#9FB3C8"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="36"
                         BackgroundColor="#264056" VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="TournWinsLabel" Text="0"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#FFD447"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Torneios" FontSize="12" TextColor="#9FB3C8"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ══ Overlay dismiss ══ -->
        <Grid x:Name="MenuDismissOverlay" Grid.RowSpan="7"
              BackgroundColor="#02000000" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuDismiss"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- ══ Dropdown menu ══ -->
        <Border x:Name="MenuDropdown" Grid.RowSpan="7"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,60,0,0"
                IsVisible="False"
                BackgroundColor="#0D2135"
                Stroke="#2A4A6A" StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="2,4" Radius="10" Opacity="0.5"/>
            </Border.Shadow>
            <VerticalStackLayout MinimumWidthRequest="170" Spacing="0">
                <Label x:Name="MenuChangePasswordItem"
                       Text="Alterar Senha"
                       FontSize="15" TextColor="#F2F5F8"
                       Padding="20,13">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuChangePasswordTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" BackgroundColor="#1A3550"/>
                <Label Text="Sair"
                       FontSize="15" TextColor="#FF6060"
                       Padding="20,13">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuLogoutTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
